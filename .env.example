# Copy this file to .env and fill in real values for local testing.
# On Render, set these as environment variables in the dashboard instead.

# --- Site ---
SITE_BASE_URL=http://localhost:5000
FLASK_SECRET_KEY=change-me-to-a-random-string
ADMIN_TOKEN=change-me-to-a-random-string   # protects /admin/orders?token=...

# --- Flutterwave (USD, NGN, bank transfer, USSD) ---
# Get these from https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=
# Set this same value as the "Secret Hash" on your Flutterwave webhook
# settings page: https://dashboard.flutterwave.com/settings/webhooks
FLUTTERWAVE_WEBHOOK_HASH=

# --- NOWPayments (Bitcoin) ---
# Get these from https://nowpayments.io/app/settings (API keys + IPN secret)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# --- Notifications ---
# Create a bot with @BotFather on Telegram, then message it once and visit
# https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_NOTIFY_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

# Optional: also email you on every payment (leave blank to skip email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=

# Where to store the local order database (defaults to ./orders.db)
ORDERS_DB_PATH=orders.db
